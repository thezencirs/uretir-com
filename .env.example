# PostgreSQL. Use a pooled runtime URL when your provider recommends one.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uretir?schema=public"

# OpenAI Responses API. The application remains fail-closed without this key
# and serves deterministic, database-grounded explanations instead.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-sol"

# Required before enabling /puan-ai/admin outside local development.
PUANAI_ADMIN_PASSWORD=""
PUANAI_SESSION_SECRET=""
# Meta WhatsApp Cloud API webhook doğrulaması
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Özel WhatsApp ajanının /api/puan-ai/intake uç noktasına erişimi
PUANAI_INGEST_TOKEN=

# Vercel Cron ve bakım uç noktası doğrulaması
CRON_SECRET=

# WhatsApp ham mesajları ve gönderici kimlikleri bu süreden sonra anonimleştirilir.
PUANAI_INTAKE_RETENTION_DAYS=90
