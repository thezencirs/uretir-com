{
  "name": "uretir-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:verify": "tsx scripts/verify-puan-ai-database.ts",
    "postinstall": "prisma generate",
    "audit:prod": "pnpm audit --prod",
    "report:gaps": "tsx scripts/report-content-gaps.ts --write",
    "report:gaps:check": "tsx scripts/report-content-gaps.ts --check",
    "report:ecosystem": "tsx scripts/report-ecosystem.ts --write",
    "report:ecosystem:check": "tsx scripts/report-ecosystem.ts --check",
    "validate:search": "node scripts/validate-search-foundation.mjs",
    "quality": "pnpm db:validate && pnpm lint && pnpm test && pnpm db:verify && pnpm audit:prod && pnpm report:gaps:check && pnpm report:ecosystem:check && pnpm build && pnpm validate:search",
    "haber-ai:collect": "tsx scripts/collect-haber-ai.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "dotenv": "17.2.3",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.25",
    "openai": "6.49.0",
    "pg": "8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.2",
    "@types/pg": "8.20.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.25",
    "postcss": "^8.4.49",
    "prisma": "7.9.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vitest": "4.1.10"
  },
  "description": "Uretir is a knowledge, community, and AI product ecosystem for people and organizations that make things. The repository contains the public Next.js application and its operating documentation.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thezencirs/uretir-com.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/thezencirs/uretir-com/issues"
  },
  "homepage": "https://github.com/thezencirs/uretir-com#readme"
}
