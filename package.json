{
  "name": "uretir-com",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "audit:prod": "pnpm audit --prod",
    "report:gaps": "tsx scripts/report-content-gaps.ts --write",
    "report:gaps:check": "tsx scripts/report-content-gaps.ts --check",
    "report:ecosystem": "tsx scripts/report-ecosystem.ts --write",
    "report:ecosystem:check": "tsx scripts/report-ecosystem.ts --check",
    "validate:search": "node scripts/validate-search-foundation.mjs",
    "quality": "pnpm lint && pnpm audit:prod && pnpm report:gaps:check && pnpm report:ecosystem:check && pnpm build && pnpm validate:search"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^15.5.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  }
}
