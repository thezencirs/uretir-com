generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum CardNetwork {
  VISA
  MASTERCARD
  TROY
  AMEX
  OTHER
}

enum CampaignStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  ACTIVE
  UPCOMING
  EXPIRED
  SUSPENDED
  UNVERIFIED
  SOURCE_UNAVAILABLE
  REJECTED
}

enum RewardKind {
  POINTS
  CASHBACK
  MILES
  DISCOUNT
  OTHER
}

enum RuleKind {
  MIN_SPEND
  MAX_SPEND
  REWARD_AMOUNT
  MAX_REWARD
  REQUIRED_PURCHASE_COUNT
  REQUIRED_CHANNEL
  REQUIRED_ENROLLMENT
  REQUIRED_PAYMENT_METHOD
  ELIGIBILITY
  EXCLUSION
  OTHER
}

enum RuleOperator {
  EQ
  GTE
  LTE
  CONTAINS
  EXCLUDES
  INFO
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  STALE
  SOURCE_UNAVAILABLE
  CONFLICT
}

enum SourceKind {
  OFFICIAL_BANK
  OFFICIAL_CARD_PROGRAM
  OFFICIAL_MERCHANT
  OFFICIAL_BRAND
  TRUSTED_MARKETPLACE
  COMPARISON_SITE
  USER_SUBMITTED
  OTHER
}

enum SourceHealth {
  ONLINE
  UNAVAILABLE
  BLOCKED
  INVALID_CONTENT
}

enum PriceAvailability {
  IN_STOCK
  OUT_OF_STOCK
  UNKNOWN
}

enum HistoryAction {
  CREATED
  UPDATED
  VERIFIED
  REJECTED
  EXPIRED
  DELETED
}

enum ChatRole {
  USER
  ASSISTANT
}

enum CampaignSubmissionStatus {
  RECEIVED
  URL_REQUIRED
  VERIFYING
  VERIFIED
  NEEDS_REVIEW
  REJECTED
  SOURCE_UNAVAILABLE
  EXPIRED
}

enum AutomationRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

model Bank {
  id           String           @id @default(uuid()) @db.Uuid
  slug         String           @unique
  name         String
  officialName String
  shortName    String
  websiteUrl   String
  color        String           @default("#769d32")
  status       RecordStatus     @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  cards        Card[]
  campaigns    Campaign[]
  sources      OfficialSource[]
  cardPrograms CardProgram[]

  @@map("banks")
}

model CardProgram {
  id         String       @id @default(uuid()) @db.Uuid
  bankId     String       @db.Uuid
  slug       String       @unique
  name       String
  websiteUrl String?
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  bank       Bank         @relation(fields: [bankId], references: [id], onDelete: Restrict)
  cards      Card[]

  @@index([bankId, status])
  @@map("card_programs")
}

model Card {
  id            String         @id @default(uuid()) @db.Uuid
  bankId        String         @db.Uuid
  slug          String         @unique
  name          String
  network       CardNetwork
  rewardProgram String?
  cardProgramId String?        @db.Uuid
  annualFee     Decimal?       @db.Decimal(12, 2)
  currency      String         @default("TRY")
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bank          Bank           @relation(fields: [bankId], references: [id], onDelete: Restrict)
  campaigns     CampaignCard[]
  cardProgram   CardProgram?   @relation(fields: [cardProgramId], references: [id], onDelete: SetNull)

  @@index([bankId, active])
  @@index([cardProgramId])
  @@map("cards")
}

model MerchantCategory {
  id        String             @id @default(uuid()) @db.Uuid
  parentId  String?            @db.Uuid
  slug      String             @unique
  name      String
  aliases   String[]           @default([])
  status    RecordStatus       @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  parent    MerchantCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  MerchantCategory[] @relation("CategoryTree")
  merchants Merchant[]
  campaigns Campaign[]

  @@map("merchant_categories")
}

model Merchant {
  id         String           @id @default(uuid()) @db.Uuid
  categoryId String           @db.Uuid
  slug       String           @unique
  name       String
  aliases    String[]         @default([])
  websiteUrl String?
  status     RecordStatus     @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  category   MerchantCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  campaigns  Campaign[]

  @@index([categoryId, status])
  @@map("merchants")
}

model RewardType {
  id        String       @id @default(uuid()) @db.Uuid
  slug      String       @unique
  name      String
  kind      RewardKind
  unit      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  campaigns Campaign[]

  @@map("reward_types")
}

model Campaign {
  id                 String             @id @default(uuid()) @db.Uuid
  bankId             String             @db.Uuid
  merchantId         String?            @db.Uuid
  merchantCategoryId String             @db.Uuid
  rewardTypeId       String?            @db.Uuid
  slug               String             @unique
  title              String
  description        String             @db.Text
  benefitSummary     String
  startDate          DateTime           @db.Timestamptz(3)
  endDate            DateTime           @db.Timestamptz(3)
  status             CampaignStatus     @default(DRAFT)
  published          Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  bank               Bank               @relation(fields: [bankId], references: [id], onDelete: Restrict)
  merchant           Merchant?          @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  merchantCategory   MerchantCategory   @relation(fields: [merchantCategoryId], references: [id], onDelete: Restrict)
  rewardType         RewardType?        @relation(fields: [rewardTypeId], references: [id], onDelete: SetNull)
  cards              CampaignCard[]
  rules              CampaignRule[]
  tiers              CampaignTier[]
  installments       Installment[]
  officialSources    OfficialSource[]
  verificationLogs   VerificationLog[]
  history            CampaignHistory[]
  conflicts          CampaignConflict[]

  @@index([status, published, startDate, endDate])
  @@index([bankId])
  @@index([merchantId])
  @@index([merchantCategoryId])
  @@map("campaigns")
}

model CampaignCard {
  campaignId String   @db.Uuid
  cardId     String   @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([campaignId, cardId])
  @@map("campaign_cards")
}

model CampaignRule {
  id           String       @id @default(uuid()) @db.Uuid
  campaignId   String       @db.Uuid
  kind         RuleKind
  operator     RuleOperator @default(INFO)
  numericValue Decimal?     @db.Decimal(14, 2)
  textValue    String?
  unit         String?
  description  String       @db.Text
  priority     Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, kind])
  @@map("campaign_rules")
}

model Installment {
  id           String   @id @default(uuid()) @db.Uuid
  campaignId   String   @db.Uuid
  count        Int
  feeFree      Boolean  @default(true)
  productScope String?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, count, productScope])
  @@index([campaignId, count])
  @@map("installments")
}

model OfficialSource {
  id               String            @id @default(uuid()) @db.Uuid
  campaignId       String            @db.Uuid
  bankId           String            @db.Uuid
  url              String
  title            String
  publisher        String
  fetchedAt        DateTime          @db.Timestamptz(3)
  publishedAt      DateTime?         @db.Timestamptz(3)
  fingerprint      String
  active           Boolean           @default(true)
  sourceKind       SourceKind        @default(OTHER)
  trustScore       Int               @default(40)
  health           SourceHealth      @default(ONLINE)
  lastVerifiedAt   DateTime?         @db.Timestamptz(3)
  validFrom        DateTime?         @db.Timestamptz(3)
  validUntil       DateTime?         @db.Timestamptz(3)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  bank             Bank              @relation(fields: [bankId], references: [id], onDelete: Restrict)
  verificationLogs VerificationLog[]

  @@unique([campaignId, url])
  @@index([campaignId, active])
  @@map("official_sources")
}

model CampaignConflict {
  id         String    @id @default(uuid()) @db.Uuid
  campaignId String    @db.Uuid
  field      String
  values     Json
  sourceIds  String[]  @default([])
  resolved   Boolean   @default(false)
  resolution String?   @db.Text
  detectedAt DateTime  @default(now()) @db.Timestamptz(3)
  resolvedAt DateTime? @db.Timestamptz(3)
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, resolved])
  @@map("campaign_conflicts")
}

model PriceObservation {
  id             String            @id @default(uuid()) @db.Uuid
  productKey     String
  productName    String
  merchantName   String
  amount         Decimal           @db.Decimal(14, 2)
  currency       String            @default("TRY")
  shippingAmount Decimal?          @db.Decimal(14, 2)
  availability   PriceAvailability @default(UNKNOWN)
  sourceUrl      String
  sourceName     String
  sourceKind     SourceKind
  trustScore     Int
  fetchedAt      DateTime          @db.Timestamptz(3)
  lastVerifiedAt DateTime          @db.Timestamptz(3)
  fingerprint    String
  createdAt      DateTime          @default(now())

  @@index([productKey, fetchedAt(sort: Desc)])
  @@map("price_observations")
}

model ScoringConfiguration {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  weights   Json
  active    Boolean  @default(true)
  version   Int      @default(1)
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("scoring_configurations")
}

model VerificationLog {
  id               String             @id @default(uuid()) @db.Uuid
  campaignId       String             @db.Uuid
  officialSourceId String             @db.Uuid
  status           VerificationStatus
  checkedAt        DateTime           @db.Timestamptz(3)
  nextCheckAt      DateTime           @db.Timestamptz(3)
  checker          String
  summary          String             @db.Text
  fingerprint      String
  createdAt        DateTime           @default(now())
  campaign         Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  officialSource   OfficialSource     @relation(fields: [officialSourceId], references: [id], onDelete: Restrict)

  @@index([campaignId, checkedAt(sort: Desc)])
  @@index([status, nextCheckAt])
  @@map("verification_logs")
}

model CampaignHistory {
  id         String        @id @default(uuid()) @db.Uuid
  campaignId String        @db.Uuid
  action     HistoryAction
  snapshot   Json
  changedBy  String
  createdAt  DateTime      @default(now())
  campaign   Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt(sort: Desc)])
  @@map("campaign_history")
}

model ChatConversation {
  id        String        @id @default(uuid()) @db.Uuid
  clientKey String
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([clientKey, updatedAt(sort: Desc)])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @db.Uuid
  role           ChatRole
  content        String           @db.Text
  campaignIds    String[]         @default([])
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model CampaignTier {
  id            String   @id @default(uuid()) @db.Uuid
  campaignId    String   @db.Uuid
  minimumSpend  Decimal  @db.Decimal(14, 2)
  maximumSpend  Decimal? @db.Decimal(14, 2)
  rewardAmount  Decimal  @db.Decimal(14, 2)
  description   String   @db.Text
  priority      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, minimumSpend, maximumSpend])
  @@map("campaign_tiers")
}

model CampaignSubmission {
  id                String                   @id @default(uuid()) @db.Uuid
  providerMessageId String                   @unique
  channelId         String?
  senderId          String?
  rawText           String                   @db.Text
  sourceUrl         String?
  receivedAt        DateTime                 @db.Timestamptz(3)
  status            CampaignSubmissionStatus @default(RECEIVED)
  verification      Json?
  normalizedDraft   Json?
  error             String?                  @db.Text
  attemptCount      Int                      @default(0)
  nextAttemptAt     DateTime?                @db.Timestamptz(3)
  processedAt       DateTime?                @db.Timestamptz(3)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([status, nextAttemptAt])
  @@index([receivedAt(sort: Desc)])
  @@map("campaign_submissions")
}

model AutomationRun {
  id          String              @id @default(uuid()) @db.Uuid
  job         String
  status      AutomationRunStatus @default(RUNNING)
  triggeredBy String
  startedAt   DateTime            @default(now()) @db.Timestamptz(3)
  completedAt DateTime?           @db.Timestamptz(3)
  summary     Json?
  error       String?             @db.Text
  createdAt   DateTime            @default(now())

  @@index([job, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@map("automation_runs")
}
